<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
  id="characteristic-display" name="Characteristic Display" revision="1"
  battleScribeVersion="2.03" gameSystemId="system-203"
  gameSystemRevision="0" library="false">
  <selectionEntries>
    <selectionEntry id="characteristic-owner" name="Characteristic Owner"
      type="unit">
      <profiles>
        <profile id="profile-direct-set" name="Direct Set"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"' />
          </modifiers>
        </profile>
        <profile id="profile-conditional" name="Conditional"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='7"'>
              <conditions>
                <condition type="atLeast" field="selections" scope="self"
                  childId="any" value="1" />
              </conditions>
            </modifier>
            <modifier type="set" field="characteristic-move" value='9"'>
              <conditions>
                <condition type="atLeast" field="selections" scope="self"
                  childId="any" value="5" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile id="profile-grouped-order" name="Grouped Order"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value="A" />
          </modifiers>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" field="characteristic-move" value="B" />
              </modifiers>
              <modifierGroups>
                <modifierGroup type="and">
                  <modifiers>
                    <modifier type="set" field="characteristic-move"
                      value="C" />
                  </modifiers>
                </modifierGroup>
              </modifierGroups>
            </modifierGroup>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" field="characteristic-move" value="D" />
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </profile>
        <profile id="profile-grouped-conditional" name="Grouped Conditional"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" field="characteristic-move"
                  value='9"' />
              </modifiers>
              <conditions>
                <condition type="atLeast" field="selections" scope="self"
                  childId="any" value="5" />
              </conditions>
            </modifierGroup>
          </modifierGroups>
        </profile>
        <profile id="profile-unsupported-operations" name="Unsupported Operations"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="multiply" field="characteristic-save" value="1" />
            <modifier type="multiply" field="characteristic-move" value="8"
              futureBehavior="unknown" />
          </modifiers>
        </profile>
        <profile id="profile-clamped" name="Clamped"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <!-- Mirrors a T'au Ethereal: 6" incremented by 4, capped at 9. -->
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <!-- Mirrors an improved save clamped at 2+: the bound is not
                 reached, so the value is left alone. -->
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="increment" field="characteristic-move" value="4" />
            <modifier type="ceil" field="characteristic-move" value="9" />
            <modifier type="decrement" field="characteristic-save" value="1" />
            <modifier type="floor" field="characteristic-save" value="2" />
          </modifiers>
        </profile>
        <profile id="profile-bonus-slot" name="Bonus Slot"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <!-- A dice expression: the slot opens and is bumped. -->
            <characteristic name="Move"
              typeId="characteristic-move">2D6</characteristic>
            <!-- A plain number: no slot, incremented directly. -->
            <characteristic name="Save"
              typeId="characteristic-save">2</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="append" field="characteristic-move" value="+0"
              join="" />
            <modifier type="increment" field="characteristic-move" value="1"
              position="-1" />
            <modifier type="replace" field="characteristic-move" arg="+0" />
            <modifier type="increment" field="characteristic-save" value="1"
              position="-1" />
            <modifier type="replace" field="characteristic-save" arg="+0" />
          </modifiers>
        </profile>
        <profile id="profile-inert-attributes" name="Inert Attributes"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">Assault</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <!-- `position` and `arg` are not offered for `append`. Both are
                 copy-paste noise and neither changes the result. -->
            <modifier type="append" field="characteristic-move" value="Heavy"
              join=", " position="-1" arg="Heavy" />
            <!-- `join` is not offered for `replace`. -->
            <modifier type="replace" field="characteristic-save" arg="4"
              value="2" join="" />
          </modifiers>
        </profile>
        <profile id="profile-corrupted-input" name="Corrupted Input"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <!-- Unsupported, so its effect on the value is unknown... -->
            <modifier type="multiply" field="characteristic-move" value="1" />
            <!-- ...and this one reads the value it was handed, so its clean
                 result is still built on an unknown input. -->
            <modifier type="increment" field="characteristic-move" value="1" />
          </modifiers>
        </profile>
        <profile id="profile-replace" name="Replace"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">D6+0</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">Assault, Lethal Hits</characteristic>
          </characteristics>
          <modifiers>
            <!-- Deleting a match: no value means replace with nothing. -->
            <modifier type="replace" field="characteristic-move"
              arg="+0" />
            <!-- The separator travels with the keyword being removed. -->
            <modifier type="replace" field="characteristic-save"
              arg=", Lethal Hits" />
          </modifiers>
        </profile>
        <profile id="profile-replace-nomatch" name="Replace No Match"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">11</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <!-- The bonus slot was never opened, so there is nothing to
                 collapse. That is the idiom's normal path, not a failure. -->
            <modifier type="replace" field="characteristic-move"
              arg="+0" />
            <!-- A Boolean where replacement text belongs would print "4true". -->
            <modifier type="replace" field="characteristic-save"
              arg="4" value="true" />
          </modifiers>
        </profile>
        <profile id="profile-arithmetic" name="Arithmetic"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <!-- Two numbers, so a bare increment cannot pick one. -->
            <characteristic name="Move"
              typeId="characteristic-move">D6+0</characteristic>
            <!-- Inverted stat: decrement improves it, which is plain
                 arithmetic on the digit. -->
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="increment" field="characteristic-move" value="1"
              position="-1" />
            <modifier type="decrement" field="characteristic-save" value="1" />
          </modifiers>
        </profile>
        <profile id="profile-arithmetic-refused" name="Arithmetic Refused"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">D6+0</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">-</characteristic>
          </characteristics>
          <modifiers>
            <!-- No position and two numbers: which one is not established. -->
            <modifier type="increment" field="characteristic-move" value="1" />
            <!-- Nothing numeric to change. -->
            <modifier type="increment" field="characteristic-save" value="1" />
          </modifiers>
        </profile>
        <profile id="profile-append" name="Append"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">Assault</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="append" field="characteristic-move" value="Heavy"
              join=", " />
            <modifier type="append" field="characteristic-move"
              value="Lethal Hits" join=", " />
            <modifier type="append" field="characteristic-save" value="0"
              join="" />
          </modifiers>
        </profile>
        <profile id="profile-append-empty" name="Append Empty"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move"></characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="append" field="characteristic-move" value="Assault"
              join=", " />
            <modifier type="append" field="characteristic-save" value="Lance" />
          </modifiers>
        </profile>
        <profile id="profile-extension-attributes" name="Extension Attributes"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"'
              affects="self.entries.recursive.profiles.Unit" />
          </modifiers>
        </profile>
        <profile id="profile-scoped" name="Scoped"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"'
              scope="parent" />
          </modifiers>
        </profile>
        <profile id="profile-missing-value" name="Missing Value"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" />
          </modifiers>
        </profile>
        <profile id="profile-unrouted" name="Unrouted"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-description"
              value="Rewritten" />
            <modifier type="set" field="hidden" value="true" />
          </modifiers>
        </profile>
        <profile id="profile-ambiguous-target" name="Ambiguous Target"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <characteristic name="Move (alternate)"
              typeId="characteristic-move">7"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='9"' />
          </modifiers>
        </profile>
        <profile id="profile-inert-comment" name="Inert Comment"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"'
              comment="Author note retained as inert metadata." />
          </modifiers>
        </profile>
        <profile id="profile-known-after-unapplied" name="Known After Unapplied"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="multiply" field="characteristic-move" value="1" />
            <modifier type="set" field="characteristic-move" value='9"' />
          </modifiers>
        </profile>
        <profile id="profile-unknown-after-applied" name="Unknown After Applied"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='9"' />
            <modifier type="multiply" field="characteristic-move" value="1" />
          </modifiers>
        </profile>
        <profile id="profile-unresolved-applicability"
          name="Unresolved Applicability" typeId="profile-type-unit"
          typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"'>
              <conditions>
                <condition type="atLeast" field="selections" scope="ancestor"
                  childId="any" value="1" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile id="profile-hidden-static" name="Hidden Static"
          typeId="profile-type-unit" typeName="Unit" hidden="true">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
        </profile>
        <profile id="profile-hidden-conditional" name="Hidden Conditional"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition type="atLeast" field="selections" scope="self"
                  childId="any" value="1" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile id="profile-hidden-inactive" name="Hidden Inactive"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition type="atLeast" field="selections" scope="self"
                  childId="any" value="5" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile id="profile-hidden-grouped" name="Hidden Grouped"
          typeId="profile-type-unit" typeName="Unit" hidden="true">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" field="hidden" value="false" />
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </profile>
        <profile id="profile-hidden-unsupported" name="Hidden Unsupported"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="increment" field="hidden" value="1" />
          </modifiers>
        </profile>
        <profile id="profile-repeated" name="Repeated"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" field="characteristic-move" value='8"'>
              <repeats>
                <repeat field="selections" scope="self" childId="any"
                  value="1" repeats="1" />
              </repeats>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="affects-owner" name="Affects Owner" type="unit">
      <profiles>
        <profile id="profile-routed-unit" name="Routed Unit"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
        </profile>
        <profile id="profile-routed-ability" name="Routed Ability"
          typeId="profile-type-ability" typeName="Ability">
          <characteristics>
            <characteristic name="Description"
              typeId="characteristic-description">Base text</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <modifiers>
        <!-- Routes to this entry's own Unit profiles by profile-type name.
             No scope, so the selector stands on the declaring occurrence. -->
        <modifier type="set" field="characteristic-move" value='9"'
          affects="profiles.Unit" />
        <!-- Case-insensitive match, as New Recruit's editor does it. -->
        <modifier type="set" field="characteristic-save" value="2+"
          affects="profiles.uNiT" />
        <!-- Targets the Ability profile only, proving type selection. -->
        <modifier type="set" field="characteristic-description"
          value="Rewritten" affects="profiles.Ability" />
        <!-- Traversal beyond the owner is not executed. -->
        <modifier type="set" field="characteristic-move" value='1"'
          affects="self.entries.recursive.profiles.Unit" />
        <!-- No selector means the annotation decorates this occurrence. -->
        <modifier type="append" field="annotation" value="Own Selection"
          join=", " />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="force-detachment" name="Force Detachment" type="unit">
      <selectionEntries>
        <!-- A detachment ability: it reaches the whole army, not its own
             subtree, and its target shares no ancestor with it. -->
        <selectionEntry id="force-rule" name="Force Rule" type="upgrade">
          <modifiers>
            <modifier type="set" field="characteristic-move" value='9"'
              affects="self.entries.forces.recursive.profiles.Unit"
              scope="roster" />
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="force-target" name="Force Target" type="unit">
      <profiles>
        <profile id="profile-force-target" name="Force Target Profile"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="affects-bearer" name="Affects Bearer" type="model">
      <profiles>
        <profile id="profile-bearer-unit" name="Bearer Unit"
          typeId="profile-type-unit" typeName="Unit">
          <characteristics>
            <characteristic name="Move"
              typeId="characteristic-move">6"</characteristic>
            <characteristic name="Save"
              typeId="characteristic-save">4+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <!-- The enhancement has no children of its own. Its selector can only
             reach the weapon by standing on the model, which is the shape
             confirmed in New Recruit with Furnace of Plagues. -->
        <selectionEntry id="bearer-enhancement" name="Bearer Enhancement"
          type="upgrade">
          <modifiers>
            <modifier type="set" field="characteristic-move" value='9"'
              affects="self.entries.recursive.profiles.Unit" scope="model" />
            <!-- Two routed steps on one characteristic. The replace only
                 finds its search term if it reads the increment's output, so
                 this fails if routed steps stop chaining. -->
            <modifier type="increment" field="characteristic-save" value="1"
              affects="self.entries.recursive.profiles.Unit" scope="model" />
            <modifier type="replace" field="characteristic-save" arg="6"
              value="2" affects="self.entries.recursive.profiles.Unit"
              scope="model" />
            <!-- A selections terminus decorates every reached occurrence,
                 independently of the profile annotations below. -->
            <modifier type="append" field="annotation"
              value="Bearer Selection" join=", "
              affects="self.entries.recursive" scope="model" />
            <!-- Annotation decorates the profile's name. Its base is always
                 empty, so the first append emits no separator and the second
                 joins onto it. -->
            <modifier type="append" field="annotation" value="Bearer Enhancement"
              join=", " affects="self.entries.recursive.profiles.Unit"
              scope="model" />
            <modifier type="append" field="annotation" value="Second Source"
              join=", " affects="self.entries.recursive.profiles.Unit"
              scope="model" />
          </modifiers>
        </selectionEntry>
        <selectionEntry id="bearer-weapon" name="Bearer Weapon" type="upgrade">
          <profiles>
            <profile id="profile-bearer-weapon" name="Bearer Weapon Profile"
              typeId="profile-type-unit" typeName="Unit">
              <characteristics>
                <characteristic name="Move"
                  typeId="characteristic-move">4"</characteristic>
                <characteristic name="Save"
                  typeId="characteristic-save">5+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="append" field="annotation"
              value="Weapon Own" join=", " />
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="affects-traversal" name="Affects Traversal"
      type="unit">
      <selectionEntries>
        <selectionEntry id="direct-child" name="Direct Child" type="model">
          <profiles>
            <profile id="profile-direct-child" name="Direct Child Profile"
              typeId="profile-type-unit" typeName="Unit">
              <characteristics>
                <characteristic name="Move"
                  typeId="characteristic-move">6"</characteristic>
                <characteristic name="Save"
                  typeId="characteristic-save">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="traversal-group" name="Traversal Group"
          defaultSelectionEntryId="none">
          <selectionEntries>
            <selectionEntry id="group-child" name="Group Child" type="model">
              <profiles>
                <profile id="profile-group-child" name="Group Child Profile"
                  typeId="profile-type-unit" typeName="Unit">
                  <characteristics>
                    <characteristic name="Move"
                      typeId="characteristic-move">6"</characteristic>
                    <characteristic name="Save"
                      typeId="characteristic-save">4+</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <modifiers>
        <!-- Reaches direct child entries only: verified in New Recruit that
             `entries` does not descend into selection-entry groups. -->
        <modifier type="set" field="characteristic-move" value='8"'
          affects="self.entries.profiles.Unit" />
        <!-- The explicit `group` segment additionally enters groups. -->
        <modifier type="set" field="characteristic-save" value="2+"
          affects="self.entries.group.profiles.Unit" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="affects-stale-value" name="Affects Stale Value"
      type="unit">
      <selectionEntries>
        <selectionEntry id="stale-child" name="Stale Child" type="model">
          <profiles>
            <profile id="profile-stale-child" name="Stale Child Profile"
              typeId="profile-type-unit" typeName="Unit">
              <characteristics>
                <characteristic name="Move"
                  typeId="characteristic-move">6"</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <modifiers>
        <!-- Applies first, making the value known... -->
        <modifier type="set" field="characteristic-move" value='8"'
          affects="self.entries.profiles.Unit" />
        <!-- ...then an unsupported operation routed to the same characteristic
             must take that value back to unknown. -->
        <modifier type="multiply" field="characteristic-move" value="1"
          affects="self.entries.profiles.Unit" />
      </modifiers>
    </selectionEntry>
  </selectionEntries>
</catalogue>
