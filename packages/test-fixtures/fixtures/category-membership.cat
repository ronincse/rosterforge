<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
  id="category-membership" name="Category Membership" revision="1"
  battleScribeVersion="2.03" gameSystemId="system-203"
  gameSystemRevision="0" library="false">
  <categoryEntries>
    <categoryEntry id="cat-infantry" name="Infantry" hidden="false" />
    <categoryEntry id="cat-battleline" name="Battleline" hidden="false" />
    <categoryEntry id="cat-character" name="Character" hidden="false" />
    <!-- No modifier anywhere targets this one, so static links fully
         determine membership and an affects filter naming it is decidable
         in pass one. -->
    <categoryEntry id="cat-immune" name="Immune Filter" hidden="false" />
    <!-- Deliberately targeted by a modifier below, so a filter naming it
         cannot be resolved without the effective-category index. -->
    <categoryEntry id="cat-mutable" name="Mutable Filter" hidden="false" />
  </categoryEntries>
  <selectionEntries>
    <selectionEntry id="static-categories" name="Static Categories"
      type="unit">
      <categoryLinks>
        <categoryLink id="static-infantry" name="Infantry"
          targetId="cat-infantry" primary="true" />
        <categoryLink id="static-character" name="Character"
          targetId="cat-character" primary="false" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry id="added-category" name="Added Category" type="unit">
      <categoryLinks>
        <categoryLink id="added-infantry" name="Infantry"
          targetId="cat-infantry" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="removed-category" name="Removed Category" type="unit">
      <categoryLinks>
        <categoryLink id="removed-infantry" name="Infantry"
          targetId="cat-infantry" primary="true" />
        <categoryLink id="removed-character" name="Character"
          targetId="cat-character" />
      </categoryLinks>
      <modifiers>
        <modifier type="remove" field="category" value="cat-character" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="redundant-add" name="Redundant Add" type="unit">
      <categoryLinks>
        <categoryLink id="redundant-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-infantry" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="conditional-category" name="Conditional Category"
      type="unit">
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline">
          <conditions>
            <condition type="atLeast" field="selections" scope="self"
              childId="any" value="1" />
          </conditions>
        </modifier>
        <modifier type="add" field="category" value="cat-character">
          <conditions>
            <condition type="atLeast" field="selections" scope="self"
              childId="any" value="5" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="grouped-category" name="Grouped Category" type="unit">
      <modifiers>
        <modifier type="add" field="category" value="cat-infantry" />
      </modifiers>
      <modifierGroups>
        <modifierGroup type="and">
          <modifiers>
            <modifier type="add" field="category" value="cat-battleline" />
          </modifiers>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="remove" field="category"
                  value="cat-infantry" />
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </modifierGroup>
      </modifierGroups>
    </selectionEntry>
    <selectionEntry id="primary-operation" name="Primary Operation"
      type="unit">
      <categoryLinks>
        <categoryLink id="primary-infantry" name="Infantry"
          targetId="cat-infantry" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline" />
        <modifier type="set-primary" field="category"
          value="cat-battleline" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="primary-implies-membership"
      name="Primary Implies Membership" type="unit">
      <categoryLinks>
        <categoryLink id="implies-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="set-primary" field="category" value="cat-character" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="primary-cleared" name="Primary Cleared" type="unit">
      <categoryLinks>
        <categoryLink id="cleared-infantry" name="Infantry"
          targetId="cat-infantry" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="unset-primary" field="category"
          value="cat-infantry" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="condition-probe" name="Condition Probe" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition type="atLeast" field="selections" scope="force"
              childId="cat-battleline" value="1" />
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition type="atLeast" field="selections" scope="force"
              childId="cat-character" value="1" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="cyclic-category" name="Cyclic Category" type="unit">
      <categoryLinks>
        <categoryLink id="cyclic-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline">
          <conditions>
            <condition type="atLeast" field="selections" scope="force"
              childId="cat-character" value="1" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="scope-anchor" name="Scope Anchor" type="unit">
      <categoryLinks>
        <categoryLink id="anchor-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="scope-child" name="Scope Child" type="model">
          <modifiers>
            <modifier type="add" field="category" value="cat-battleline"
              scope="parent" />
            <modifier type="remove" field="category" value="cat-infantry"
              scope="root-entry" />
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="scoped-category" name="Scoped Category" type="unit">
      <categoryLinks>
        <categoryLink id="scoped-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline"
          scope="parent" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="affects-category" name="Affects Category" type="unit">
      <categoryLinks>
        <categoryLink id="affects-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline"
          affects="self.entries.recursive" />
      </modifiers>
      <selectionEntries>
        <selectionEntry id="affects-direct-child" name="Affects Direct Child"
          type="upgrade" />
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="affects-group" name="Affects Group">
          <selectionEntries>
            <selectionEntry id="affects-group-child"
              name="Affects Group Child" type="upgrade" />
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="affects-children-only" name="Affects Children Only"
      type="unit">
      <modifiers>
        <!-- `entries` without `recursive` is the New Recruit contrast: it
             reaches direct child entries but does not descend into a
             selection-entry group. -->
        <modifier type="add" field="category" value="cat-battleline"
          affects="self.entries" />
      </modifiers>
      <selectionEntries>
        <selectionEntry id="shallow-direct-child" name="Shallow Direct Child"
          type="upgrade" />
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="shallow-group" name="Shallow Group">
          <selectionEntries>
            <selectionEntry id="shallow-group-child"
              name="Shallow Group Child" type="upgrade" />
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="affects-filtered" name="Affects Filtered" type="unit">
      <categoryLinks>
        <categoryLink id="affects-filtered-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline"
          affects="self.entries.recursive.cat-immune" />
      </modifiers>
      <selectionEntries>
        <selectionEntry id="affects-member-child" name="Affects Member Child"
          type="upgrade">
          <categoryLinks>
            <categoryLink id="affects-member-link" name="Immune Filter"
              targetId="cat-immune" primary="false" />
          </categoryLinks>
        </selectionEntry>
        <selectionEntry id="affects-outsider-child"
          name="Affects Outsider Child" type="upgrade" />
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="affects-mutable" name="Affects Mutable" type="unit">
      <categoryLinks>
        <categoryLink id="affects-mutable-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <modifier type="add" field="category" value="cat-battleline"
          affects="self.entries.recursive.cat-mutable" />
      </modifiers>
      <selectionEntries>
        <selectionEntry id="affects-mutable-child"
          name="Affects Mutable Child" type="upgrade" />
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="affects-relocated" name="Affects Relocated"
      type="unit">
      <categoryLinks>
        <categoryLink id="affects-relocated-infantry" name="Infantry"
          targetId="cat-infantry" />
      </categoryLinks>
      <modifiers>
        <!-- The shape every corpus instance takes: a descendant selector on an
             occurrence with no descendants, plus a scope naming another
             anchor. Undetermined rather than vacuous. -->
        <modifier type="add" field="category" value="cat-battleline"
          affects="self.entries.recursive.cat-immune" scope="model" />
      </modifiers>
    </selectionEntry>
    <selectionEntry id="mutable-source" name="Mutable Source" type="unit">
      <modifiers>
        <!-- Existence is the point: it disproves cat-mutable's immunity. -->
        <modifier type="add" field="category" value="cat-mutable" />
      </modifiers>
    </selectionEntry>
  </selectionEntries>
</catalogue>
