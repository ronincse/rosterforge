<?xml version="1.0" encoding="UTF-8"?>
<!-- Fictional stat-keyword popup cases, including uncertainty and false matches.
     Transitive association traversal deliberately retains uncertainty. -->
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="keyword-reference" name="Keyword Reference" revision="1" battleScribeVersion="2.03" gameSystemId="system-203" gameSystemRevision="0" library="false">
  <selectionEntries><selectionEntry id="keyword-unit" name="Keyword Readers" type="unit">
    <profiles>
      <profile id="keyword-gun" name="Reference gun" typeId="keyword-ranged" typeName="Ranged Weapons"><characteristics>
        <characteristic name="A" typeId="keyword-attacks">2</characteristic>
        <characteristic name="Keywords" typeId="keyword-field">Rapid Fire 4, Anti-Infantry 3+, Psychic Assassin, Unknown, Uncertain, Hidden, Ambiguous</characteristic>
      </characteristics></profile>
      <profile id="keyword-blade" name="Reference blade" typeId="keyword-melee" typeName="Melee Weapons"><characteristics>
        <characteristic name="A" typeId="keyword-attacks">1</characteristic>
        <characteristic name="Keywords" typeId="keyword-field"></characteristic>
      </characteristics></profile>
    </profiles>
    <rules>
      <rule id="rapid" name="Rapid Fire"><description>Fictional rapid fire reference.</description></rule>
      <rule id="anti" name="Anti"><description>Fictional anti reference.</description></rule>
      <rule id="psychic" name="Psychic"><description>Must not match Psychic Assassin.</description></rule>
      <rule id="uncertain" name="Uncertain"><description>Applicability is not confirmed.</description><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="atLeast" field="associations" traverseAssociationGroup="true" scope="self" childId="any" value="1" shared="true" /></conditions></modifier></modifiers></rule>
      <rule id="hidden" name="Hidden" hidden="true"><description>Not applicable.</description></rule>
      <rule id="ambiguous-one" name="Ambiguous"><description>One possible definition.</description></rule>
      <rule id="ambiguous-two" name="Ambiguous"><description>Another possible definition.</description></rule>
    </rules>
  </selectionEntry></selectionEntries>
</catalogue>
