<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
  id="selection-initialization" name="Selection Initialization" revision="1"
  battleScribeVersion="2.03" gameSystemId="system-203"
  gameSystemRevision="0" library="false">
  <categoryEntries>
    <categoryEntry id="initialization-category-units" name="Units" />
    <categoryEntry id="initialization-category-configuration"
      name="Configuration" />
  </categoryEntries>
  <forceEntries>
    <forceEntry id="initialization-force" name="Initialization Force" />
  </forceEntries>
  <entryLinks>
    <entryLink id="duplicate-initialization-root"
      name="Duplicate Initialization Unit" targetId="initialization-unit"
      type="selectionEntry" />
  </entryLinks>
  <selectionEntries>
    <selectionEntry id="initialization-unit" name="Initialization Unit"
      type="unit">
      <categoryLinks>
        <categoryLink id="initialization-unit-category" name="Units"
          targetId="initialization-category-units" primary="true" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="required-model" name="Required Model" type="model">
          <selectionEntries>
            <selectionEntry id="required-weapon" name="Required Weapon"
              type="upgrade">
              <constraints>
                <constraint id="required-weapon-min" type="min"
                  field="selections" scope="parent" value="1" />
                <constraint id="required-weapon-max" type="max"
                  field="selections" scope="parent" value="1" />
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <constraints>
            <constraint id="required-model-min" type="min"
              field="selections" scope="parent" value="2" />
            <constraint id="required-model-max" type="max"
              field="selections" scope="parent" value="2" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="modified-child" name="Modified Child"
          type="upgrade">
          <constraints>
            <constraint id="modified-child-min" type="min"
              field="selections" scope="parent" value="1" />
          </constraints>
          <modifiers>
            <modifier type="set" field="modified-child-min" value="0" />
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="default-group" name="Default Group"
          defaultSelectionEntryId="default-option">
          <selectionEntries>
            <selectionEntry id="default-option" name="Default Option"
              type="upgrade">
              <constraints>
                <constraint id="default-option-max" type="max"
                  field="selections" scope="parent" value="1" />
              </constraints>
            </selectionEntry>
            <selectionEntry id="alternate-option" name="Alternate Option"
              type="upgrade" />
          </selectionEntries>
          <constraints>
            <constraint id="default-group-min" type="min"
              field="selections" scope="parent" value="1" />
            <constraint id="default-group-max" type="max"
              field="selections" scope="parent" value="1" />
          </constraints>
        </selectionEntryGroup>
        <selectionEntryGroup id="manual-group" name="Manual Group"
          defaultSelectionEntryId="none">
          <selectionEntries>
            <selectionEntry id="manual-option-one" name="Manual Option One"
              type="upgrade" />
            <selectionEntry id="manual-option-two" name="Manual Option Two"
              type="upgrade" />
          </selectionEntries>
          <constraints>
            <constraint id="manual-group-min" type="min"
              field="selections" scope="parent" value="1" />
            <constraint id="manual-group-max" type="max"
              field="selections" scope="parent" value="1" />
          </constraints>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <constraints>
        <constraint id="initialization-unit-roster-min" type="min"
          field="selections" scope="roster" value="1" shared="true"
          includeChildSelections="true" includeChildForces="true" />
        <constraint id="initialization-unit-roster-max" type="max"
          field="selections" scope="roster" value="1" shared="true"
          includeChildSelections="true" includeChildForces="true" />
      </constraints>
    </selectionEntry>
    <selectionEntry id="automatic-reconciliation-unit"
      name="Automatic Reconciliation Unit" type="unit">
      <categoryLinks>
        <categoryLink id="automatic-reconciliation-unit-category"
          name="Units" targetId="initialization-category-units"
          primary="true" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="automatic-default-model"
          name="Automatic Default Model" type="model">
          <constraints>
            <constraint id="automatic-default-min" type="min"
              field="selections" scope="parent" value="4"
              shared="true" automatic="true" />
            <constraint id="automatic-default-max" type="max"
              field="selections" scope="parent" value="4"
              shared="true" automatic="true" />
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="decrement" value="1"
                  field="automatic-default-min" />
                <modifier type="decrement" value="1"
                  field="automatic-default-max" />
              </modifiers>
              <conditions>
                <condition type="atLeast" value="1" field="selections"
                  scope="parent" childId="automatic-alternate-model"
                  shared="true" includeChildSelections="false" />
              </conditions>
            </modifierGroup>
          </modifierGroups>
        </selectionEntry>
        <selectionEntry id="automatic-alternate-model"
          name="Automatic Alternate Model" type="model">
          <constraints>
            <constraint id="automatic-alternate-max" type="max"
              field="selections" scope="parent" value="1" shared="true" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="manual-default-model"
          name="Manual Default Model" type="model">
          <constraints>
            <constraint id="manual-default-min" type="min"
              field="selections" scope="parent" value="2"
              shared="true" automatic="false" />
            <constraint id="manual-default-max" type="max"
              field="selections" scope="parent" value="2"
              shared="true" automatic="false" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="automatic-activation-trigger"
          name="Automatic Activation Trigger" type="upgrade">
          <constraints>
            <constraint id="automatic-activation-trigger-max" type="max"
              field="selections" scope="parent" value="1" shared="true" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="automatic-activated-upgrade"
          name="Automatically Activated Upgrade" type="upgrade"
          hidden="true">
          <constraints>
            <constraint id="automatic-activated-min" type="min"
              field="selections" scope="parent" value="0"
              shared="true" automatic="true" />
            <constraint id="automatic-activated-max" type="max"
              field="selections" scope="parent" value="0"
              shared="true" automatic="true" />
          </constraints>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" value="false" field="hidden" />
                <modifier type="set" value="1"
                  field="automatic-activated-min" />
                <modifier type="set" value="1"
                  field="automatic-activated-max" />
              </modifiers>
              <conditions>
                <condition type="atLeast" value="1" field="selections"
                  scope="unit" childId="automatic-activation-trigger"
                  shared="true" includeChildSelections="true" />
              </conditions>
            </modifierGroup>
          </modifierGroups>
        </selectionEntry>
        <selectionEntry id="automatic-shared-trigger"
          name="Automatic Shared Trigger" type="upgrade">
          <constraints>
            <constraint id="automatic-shared-trigger-max" type="max"
              field="selections" scope="parent" value="1" shared="true" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink id="automatic-shared-first-link"
          name="Automatic Shared First"
          targetId="automatic-shared-choice" type="selectionEntry" />
        <entryLink id="automatic-shared-second-link"
          name="Automatic Shared Second"
          targetId="automatic-shared-choice" type="selectionEntry" />
      </entryLinks>
    </selectionEntry>
    <selectionEntry id="disabled-automatic-root"
      name="Disabled Automatic Root" type="upgrade">
      <categoryLinks>
        <categoryLink id="disabled-automatic-root-category"
          name="Configuration"
          targetId="initialization-category-configuration" primary="true" />
      </categoryLinks>
      <constraints>
        <constraint id="disabled-automatic-root-min" type="min"
          field="selections" scope="force" value="1" shared="true" />
        <constraint id="disabled-automatic-root-max" type="max"
          field="selections" scope="force" value="1" shared="true" />
      </constraints>
      <modifiers>
        <modifier type="set" field="disabled-automatic-root-min" value="0" />
      </modifiers>
    </selectionEntry>
  </selectionEntries>
  <sharedSelectionEntries>
    <selectionEntry id="automatic-shared-choice"
      name="Automatic Shared Choice" type="upgrade">
      <constraints>
        <constraint id="automatic-shared-min" type="min"
          field="selections" scope="parent" value="0"
          shared="true" automatic="true" />
      </constraints>
      <modifierGroups>
        <modifierGroup type="and">
          <modifiers>
            <modifier type="set" value="1" field="automatic-shared-min" />
          </modifiers>
          <conditions>
            <condition type="atLeast" value="1" field="selections"
              scope="unit" childId="automatic-shared-trigger"
              shared="true" includeChildSelections="true" />
          </conditions>
        </modifierGroup>
      </modifierGroups>
    </selectionEntry>
  </sharedSelectionEntries>
</catalogue>
